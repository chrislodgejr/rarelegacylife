# Endless One intake (server-only): when both are set, each quote request, contact message and retirement request is also sent to
# Endless One, signed with the shared secret, before the site saves its own copy. Leave empty to send nothing. The URL is
# https://<Endless One project>.supabase.co/functions/v1/rare-legacy-intake; the secret is the value saved in Endless One under
# Settings > Connections > Rare Legacy website intake (never commit it).
ENDLESS_ONE_INTAKE_URL=
ENDLESS_ONE_INTAKE_SECRET=

